+/* The CCC survives a bonded disconnect, while its AcquireNotify socket is
+ * scoped to the old ATT. The host need not write the CCC on the new link. */
+static gboolean restore_notify_fds(gpointer data)
+{
+	struct device_state *state = data;
+	struct btd_device *device = btd_adapter_find_device(state->db->adapter,
+					&state->bdaddr, state->bdaddr_type);
+	struct bt_gatt_server *server;
+	struct bt_att *att;
+	const struct queue_entry *entry;
+	bool waiting = false;
+
+	if (!device || !device_is_bonded(device, state->bdaddr_type))
+		goto done;
+	server = btd_device_get_gatt_server(device);
+	if (!server)
+		goto done;
+	att = bt_gatt_server_get_att(server);
+	if (find_device_state_by_att(state->db, att) != state)
+		goto done;
+
+	for (entry = queue_get_entries(state->ccc_states); entry; entry = entry->next) {
+		struct ccc_state *ccc = entry->data;
+		struct external_chrc *chrc = ccc->fd_chrc;
+		struct pending_op *op;
+
+		if (!ccc->value || !chrc || ccc->restore_attempts >= MAX_NOTIFY_RESTORE_ATTEMPTS ||
+				queue_find(chrc->notify_ios, match_client_att, att))
+			continue;
+		waiting = true;
+		if (ccc->acquiring || bt_att_get_security(att, NULL) < BT_ATT_SECURITY_MEDIUM ||
+				!bt_gatt_server_can_write(server, chrc->ccc))
+			continue;
+		ccc->restore_attempts++;
+		op = pending_ccc_new(att, chrc->ccc, ccc->value, ccc);
+		if (op && !acquire_notify(chrc, op))
+			pending_op_free(op);
+	}
+	if (waiting)
+		return G_SOURCE_CONTINUE;
+done:
+	state->restore_timer = 0;
+	return G_SOURCE_REMOVE;
+}
+
+static bool ccc_has_notify_fd(const void *data, const void *user_data)
+{
+	const struct ccc_state *ccc = data;
+	return ccc->fd_chrc != NULL;
+}
