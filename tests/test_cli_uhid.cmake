# Parameter failures must precede any ADB/USB access.
function(invalid pattern)
  execute_process(COMMAND "${CLI}" --transport uhid ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 5)
  if(NOT result EQUAL 2 OR NOT error MATCHES "${pattern}")
    message(FATAL_ERROR "Unexpected UHID validation: ${result}: ${output}${error}")
  endif()
endfunction()
if(NOT UHID)
  invalid("BUILD_UHID=ON" --adb-serial PHONE)
  return()
endif()
invalid("explicit --adb-serial")
invalid("explicit --adb-serial" --serial PHONE)
invalid("cannot be combined" --adb-serial PHONE --serial OTHER)
invalid("cannot be combined" --adb-serial PHONE --adapter hci1)
invalid("cannot be combined" --adb-serial PHONE --ble-session)
invalid("cannot be combined" --adb-serial PHONE --ble-service)
invalid("scrcpy-server and --scrcpy-version" --adb-serial PHONE)
