# Parser rejection only. No valid service, adapter or HID request is started.
function(reject)
  execute_process(COMMAND "${CLI}" ${ARGN}
    RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
  if(NOT code STREQUAL "2")
    message(FATAL_ERROR "Expected argument error for ${ARGN}: ${code} ${out} ${err}")
  endif()
endfunction()
reject(--ble-session)
reject(--ble-directed-session)
reject(--transport ble --ble-session --ble-directed-session)
reject(--transport ble --ble-session --ble-directed-session --ble-peer AA:BB:CC:DD:EE:FF --ble-isolate)
reject(--transport ble --ble-isolate)
reject(--ble-multi invalid)
reject(--ble-service --ble-multi invalid --ble-isolate --gui)
reject(--adb-serial 192.168.1.20:5555)
# The internal PIN-file hand-off authorizes a BLE bridge to use an explicit
# ADB target; standalone BLE service operations must still reject it.
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/unlock-pin.txt" "1234")
execute_process(COMMAND "${CLI}" --unlock-pin-file "${CMAKE_CURRENT_BINARY_DIR}/unlock-pin.txt"
  --adb-serial fake --ble-service RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
if(NOT code STREQUAL "2" OR err MATCHES "requires --audio or --clipboard")
  message(FATAL_ERROR "PIN-file ADB gate was not parsed correctly: ${code} ${out} ${err}")
endif()
reject(--clipboard)
reject(--clipboard --serial fake)
reject(--clipboard --adb-serial fake --scrcpy-server fake --scrcpy-version 5.0.1 --ble-service)
if(DEFINED CLIPBOARD AND NOT CLIPBOARD)
  reject(--clipboard --serial fake --scrcpy-server fake --scrcpy-version 5.0.1)
endif()
reject(--transport ble --ble-peer invalid)
reject(--tls)
reject(--right-button-action home)
reject(--right-button-action)
reject(--tls-cert fake)
reject(--tls --tls-fingerprint 0011 --tls-fingerprint-file fake)
reject(--ble-status --adapter hci0/../../x)
reject(--ble-status --adapter hci65535)
reject(--ble-status --ble-stop-service)
reject(--ble-service --gui)
reject(--mouse-mode relative --absolute-per-axis)
reject(--ble-legacy-handles)
reject(--ble-status --ble-legacy-handles)
reject(--ble-stop-service --ble-legacy-handles)
reject(--ble-restore --ble-legacy-handles)
reject(--transport ble --ble-peer AA:BB:CC:DD:EE:FF --ble-session --mouse-mode relative)
# EOF cancels startup after validation and before opening any BLE adapter.
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/ble-gui-eof.txt" "")
execute_process(COMMAND "${CLI}" --transport ble --gui
  INPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/ble-gui-eof.txt"
  RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
if(NOT code STREQUAL "0")
  message(FATAL_ERROR "BLE GUI startup without an address failed: ${code} ${out} ${err}")
endif()
if(LINUX_BLE)
  execute_process(COMMAND "${CLI}" --transport ble --ble-session --ble-legacy-handles --gui
    INPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/ble-gui-eof.txt"
    RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
  if(NOT code STREQUAL "0")
    message(FATAL_ERROR "Linux BLE legacy-handle GUI startup failed: ${code} ${out} ${err}")
  endif()
endif()
if(WINDOWS_BLE)
  reject(--gui-ble-control)
  reject(--gui --gui-ble-control --serial test)
  reject(--transport ble --ble-peer AA:BB:CC:DD:EE:FF --mouse-mode relative)
  reject(--transport ble --ble-peer AA:BB:CC:DD:EE:FF --adapter hci0)
  reject(--transport ble --ble-peer AA:BB:CC:DD:EE:FF --serial test)
  reject(--transport ble --ble-peer AA:BB:CC:DD:EE:FF --gui --background)
  reject(--transport ble --ble-peer AA:BB:CC:DD:EE:FF --ble-isolate)
  reject(--transport ble --ble-peer AA:BB:CC:DD:EE:FF --ble-session)
  reject(--transport ble --ble-legacy-handles)
  # EOF cancels GUI startup before opening Bluetooth. Exercise the real parser
  # and stdin stop path without accessing any adapter or modifying pairings.
  execute_process(COMMAND "${CLI}" --transport ble --ble-peer AA:BB:CC:DD:EE:FF --gui --gui-ble-control
    INPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/ble-gui-eof.txt"
    RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 5)
  if(NOT code STREQUAL "0")
    message(FATAL_ERROR "GUI BLE EOF cancellation failed: ${code} ${out} ${err}")
  endif()
endif()
